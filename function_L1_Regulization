#================================================================
# Load Main doFBLR function
#================================================================

doFBLR <- function(data, burnIn = 1000, adapt = 100, numChain = 2, thinning = 7,
                   priorMeanZbeta = 0, priorVarZbeta = 1 / 4, RV_name = "Class",
                   min_tau1 = 0.001, max_tau1 = 0.999, min_tau2 = 0.001, max_tau2 = 0.999) {
  
  # Preprocess data
  y <- data[[RV_name]]
  x <- as.matrix(data %>% select(-all_of(RV_name)))
  if (any(!is.finite(y))) stop("All y values must be finite.")
  if (any(!is.finite(x))) stop("All x values must be finite.")
  
  # Standardize predictors
  x_mean <- colMeans(x)
  x_sd <- apply(x, 2, sd)
  zx <- sweep(x, 2, x_mean, "-")
  zx <- sweep(zx, 2, x_sd, "/")
  
  # JAGS data
  dataList <- list(
    zx = zx,
    y = y,
    Nx = ncol(zx),
    Ntotal = nrow(zx),
    lambda = 1
  )
  
  # Write JAGS model to file
  modelString <- "
    model {
        for (i in 1:Ntotal) {
            m[i] <- guess * 0.5 + (1 - guess) * ilogit(zbeta0 + sum(zbeta[1:Nx] * zx[i,1:Nx]))
            y[i] ~ dbern(m[i])
        }
        guess ~ dbeta(1, 11)
        zbeta0 ~ dnorm(0, 1/4)
        for (j in 1:Nx) {
            zbeta[j] ~ dnorm(0, lambda)
        }
        lambda ~ dgamma(0.1, 0.1)
    }
  "
  writeLines(modelString, con = "TEMPmodel.txt")
  
  # Run JAGS model
  parameters <- c("zbeta0", "zbeta")
  runJagsOut <- run.jags(
    model = "TEMPmodel.txt",
    monitor = parameters,
    data = dataList,
    n.chains = numChain,
    adapt = adapt,
    burnin = burnIn,
    thin = thinning,
    summarise = FALSE,
    plots = FALSE
  )
  codaSamples <- as.mcmc.list(runJagsOut)
  model_summary <- summary(runJagsOut)
  
  # Extract coefficients
  gaussian_fuzzy_matrix <- do.call(rbind, lapply(1:ncol(zx), function(i) {
    c(model_summary$statistics[i, "Mean"], model_summary$statistics[i, "SD"])
  }))
  
  # Perform other steps...
  # Add code for GFN logistic function, classification, grid search, etc.
  
  # Return results
  return(list(
    coefficients = gaussian_fuzzy_matrix,
    model_summary = model_summary,
    samples = codaSamples
  ))
}
